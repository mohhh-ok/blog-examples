  },
  {
    "exp": "B",
    "tag": "b_r26_run5",
    "ref": "r26",
    "text": "本日は晴天なり。マイクのテスト中です。この音声は、ゼロショット音声合成のサンプルです。",
    "model": "s2.1-pro",
    "elapsed_s": 2.8,
    "ok": true,
    "audio_s": 7.94,
    "bytes": 700460
  },
  {
    "exp": "C",
    "tag": "c1",
    "ref": "r10",
    "text": "了解しました。明日の朝、東雲駅で待ち合わせましょう。",
    "model": "s2.1-pro",
    "elapsed_s": 1.83,
    "ok": true,
    "audio_s": 4.5,
    "bytes": 397356
  },
  {
    "exp": "C",
    "tag": "c2",
    "ref": "r10",
    "text": "雰囲気のいい店で、代替案について早急に検討した。",
    "model": "s2.1-pro",
    "elapsed_s": 1.94,
    "ok": true,
    "audio_s": 4.13,
    "bytes": 364588
  },
  {
    "exp": "C",
    "tag": "c3",
    "ref": "r10",
    "text": "彼は人気のない道を歩いた。",
    "model": "s2.1-pro",
    "elapsed_s": 1.16,
    "ok": true,
    "audio_s": 2.23,
    "bytes": 196652
  },
  {
    "exp": "C",
    "tag": "c4",
    "ref": "r10",
    "text": "一日中、日本橋で過ごした。",
    "model": "s2.1-pro",
    "elapsed_s": 0.87,
    "ok": true,
    "audio_s": 2.41,
    "bytes": 213036
  },
  {
    "exp": "C",
    "tag": "c5",
    "ref": "r10",
    "text": "今日は八日、明後日は十日です。",
    "model": "s2.1-pro",
    "elapsed_s": 1.01,
    "ok": true,
    "audio_s": 2.55,
    "bytes": 225324
  },
  {
    "exp": "R",
    "tag": "r001",
    "ref": "r10",
    "text": "その政治家の発言は、政界に大きな嵐を巻き起こした。",
    "key": "嵐_あらし_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.5,
    "ok": true,
    "audio_s": 4.27,
    "bytes": 376876
  },
  {
    "exp": "R",
    "tag": "r002",
    "ref": "r10",
    "text": "祖母は古い草履を大切に保管している。",
    "key": "草履_ぞうり_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.39,
    "ok": true,
    "audio_s": 2.88,
    "bytes": 253996
  },
  {
    "exp": "R",
    "tag": "r003",
    "ref": "r10",
    "text": "疲れた体をソファーに沈める。",
    "key": "沈_しずめる_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.13,
    "ok": true,
    "audio_s": 2.41,
    "bytes": 213036
  },
  {
    "exp": "R",
    "tag": "r004",
    "ref": "r10",
    "text": "基地の司令官が交代した。",
    "key": "司_シ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.11,
    "ok": true,
    "audio_s": 2.18,
    "bytes": 192556
  },
  {
    "exp": "R",
    "tag": "r005",
    "ref": "r10",
    "text": "この地域は夜になると物騒になるので、気を付けてください。",
    "key": "騒_ソウ_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.47,
    "ok": true,
    "audio_s": 4.18,
    "bytes": 368684
  },
  {
    "exp": "R",
    "tag": "r006",
    "ref": "r10",
    "text": "その案件については、一旦保留とします。",
    "key": "留_リュウ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.05,
    "ok": true,
    "audio_s": 2.93,
    "bytes": 258092
  },
  {
    "exp": "R",
    "tag": "r007",
    "ref": "r10",
    "text": "彼らはただの冷やかしのつもりだったが、新郎は本当に怒ってしまった。",
    "key": "冷_ひやかす_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.86,
    "ok": true,
    "audio_s": 5.02,
    "bytes": 442412
  },
  {
    "exp": "R",
    "tag": "r008",
    "ref": "r10",
    "text": "このリストから奇数だけを選んでください。",
    "key": "奇_キ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.01,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r009",
    "ref": "r10",
    "text": "庭の芝生を短く刈り込む。",
    "key": "芝生_しばふ_1",
    "model": "s2.1-pro",
    "elapsed_s": 0.92,
    "ok": true,
    "audio_s": 2.23,
    "bytes": 196652
  },
  {
    "exp": "R",
    "tag": "r010",
    "ref": "r10",
    "text": "故人の冥福を心よりお祈り申し上げます。",
    "key": "冥_メイ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.09,
    "ok": true,
    "audio_s": 2.88,
    "bytes": 253996
  },
  {
    "exp": "R",
    "tag": "r011",
    "ref": "r10",
    "text": "そのピアニストは、技巧によって聴衆を驚かす。",
    "key": "驚_おどろかす_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.52,
    "ok": true,
    "audio_s": 3.76,
    "bytes": 331820
  },
  {
    "exp": "R",
    "tag": "r012",
    "ref": "r10",
    "text": "彼は規則を破ったので、部長に叱られた。",
    "key": "叱_しかる_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.45,
    "ok": true,
    "audio_s": 3.34,
    "bytes": 294956
  },
  {
    "exp": "R",
    "tag": "r013",
    "ref": "r10",
    "text": "問題が解決したので、早速次のステップに移りましょう。",
    "key": "早_サッ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.51,
    "ok": true,
    "audio_s": 4.18,
    "bytes": 368684
  },
  {
    "exp": "R",
    "tag": "r014",
    "ref": "r10",
    "text": "伝統的な数寄屋建築の美しさに感動した。",
    "key": "数寄屋_すきや_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.52,
    "ok": true,
    "audio_s": 3.48,
    "bytes": 307244
  },
  {
    "exp": "R",
    "tag": "r015",
    "ref": "r10",
    "text": "長い教師生活を終える日、彼女は感極まっていた。",
    "key": "終_おえる_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.73,
    "ok": true,
    "audio_s": 4.32,
    "bytes": 380972
  },
  {
    "exp": "R",
    "tag": "r016",
    "ref": "r10",
    "text": "先生が私に資料を下さった。",
    "key": "下_くださる_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.14,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r017",
    "ref": "r10",
    "text": "定年後、世界各地を漫遊する計画を立てている。",
    "key": "漫_マン_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.38,
    "ok": true,
    "audio_s": 3.85,
    "bytes": 340012
  },
  {
    "exp": "R",
    "tag": "r018",
    "ref": "r10",
    "text": "寒さで唇を真っ青にしている。",
    "key": "真っ青_まっさお_2",
    "model": "s2.1-pro",
    "elapsed_s": 0.93,
    "ok": true,
    "audio_s": 2.32,
    "bytes": 204844
  },
  {
    "exp": "R",
    "tag": "r019",
    "ref": "r10",
    "text": "彼女の勤勉さが成功の秘訣です。",
    "key": "勤_キン_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.11,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r020",
    "ref": "r10",
    "text": "彼は午前中、来客応対と資料作成の執務をこなした。",
    "key": "執_シツ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.8,
    "ok": true,
    "audio_s": 4.69,
    "bytes": 413740
  },
  {
    "exp": "R",
    "tag": "r021",
    "ref": "r10",
    "text": "部屋には私一人しか残っていない。",
    "key": "一人_ひとり_1",
    "model": "s2.1-pro",
    "elapsed_s": 0.97,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r022",
    "ref": "r10",
    "text": "洗濯物がまだ少し湿っているので、乾燥機に入れる。",
    "key": "湿_しめる_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.65,
    "ok": true,
    "audio_s": 3.72,
    "bytes": 327724
  },
  {
    "exp": "R",
    "tag": "r023",
    "ref": "r10",
    "text": "この地域では、新たな光ケーブルの敷設工事が進んでいる。",
    "key": "敷_フ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.66,
    "ok": true,
    "audio_s": 4.09,
    "bytes": 360492
  },
  {
    "exp": "R",
    "tag": "r024",
    "ref": "r10",
    "text": "彼らは互いに助け合って困難を乗り越えた。",
    "key": "互_たがい_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.36,
    "ok": true,
    "audio_s": 3.02,
    "bytes": 266284
  },
  {
    "exp": "R",
    "tag": "r025",
    "ref": "r10",
    "text": "権力を弄ぶ政治家にはうんざりだ。",
    "key": "弄_もてあそぶ_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.14,
    "ok": true,
    "audio_s": 3.02,
    "bytes": 266284
  },
  {
    "exp": "R",
    "tag": "r026",
    "ref": "r10",
    "text": "地震で家の柱が大きく振れた。",
    "key": "振_ふれる_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.03,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r027",
    "ref": "r10",
    "text": "スポンジが水を吸収する。",
    "key": "吸_キュウ_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.92,
    "ok": true,
    "audio_s": 2.28,
    "bytes": 200748
  },
  {
    "exp": "R",
    "tag": "r028",
    "ref": "r10",
    "text": "この庭園は、日本の伝統的な趣がある。",
    "key": "趣_おもむき_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.2,
    "ok": true,
    "audio_s": 3.39,
    "bytes": 299052
  },
  {
    "exp": "R",
    "tag": "r029",
    "ref": "r10",
    "text": "彼は将来に対する強い希望を持っている。",
    "key": "望_ボウ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.28,
    "ok": true,
    "audio_s": 3.07,
    "bytes": 270380
  },
  {
    "exp": "R",
    "tag": "r030",
    "ref": "r10",
    "text": "納期が迫り、仕事のペースを上げようと焦る。",
    "key": "焦_あせる_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.43,
    "ok": true,
    "audio_s": 3.34,
    "bytes": 294956
  },
  {
    "exp": "R",
    "tag": "r031",
    "ref": "r10",
    "text": "彼は情け深い人だ。",
    "key": "情_なさけ_1",
    "model": "s2.1-pro",
    "elapsed_s": 0.71,
    "ok": true,
    "audio_s": 1.72,
    "bytes": 151596
  },
  {
    "exp": "R",
    "tag": "r032",
    "ref": "r10",
    "text": "彼は古い蛇の目傘を差して歩いていた。",
    "key": "蛇_ジャ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.37,
    "ok": true,
    "audio_s": 3.16,
    "bytes": 278572
  },
  {
    "exp": "R",
    "tag": "r033",
    "ref": "r10",
    "text": "農家はこれから苗代の準備を始める。",
    "key": "代_しろ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.07,
    "ok": true,
    "audio_s": 2.74,
    "bytes": 241708
  },
  {
    "exp": "R",
    "tag": "r034",
    "ref": "r10",
    "text": "まだ中間地点だ。気を緩めるな！",
    "key": "緩_ゆるめる_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.04,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r035",
    "ref": "r10",
    "text": "親は子供の成長を願っています。",
    "key": "親_おや_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.95,
    "ok": true,
    "audio_s": 2.37,
    "bytes": 208940
  },
  {
    "exp": "R",
    "tag": "r036",
    "ref": "r10",
    "text": "彼は権力に強く抵抗した。",
    "key": "抵_テイ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.16,
    "ok": true,
    "audio_s": 2.28,
    "bytes": 200748
  },
  {
    "exp": "R",
    "tag": "r037",
    "ref": "r10",
    "text": "困った時はいつでも両親に頼るべきだ。",
    "key": "頼_たよる_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.02,
    "ok": true,
    "audio_s": 2.55,
    "bytes": 225324
  },
  {
    "exp": "R",
    "tag": "r038",
    "ref": "r10",
    "text": "図書館で古い資料を閲覧した。",
    "key": "閲_エツ_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.98,
    "ok": true,
    "audio_s": 2.46,
    "bytes": 217132
  },
  {
    "exp": "R",
    "tag": "r039",
    "ref": "r10",
    "text": "彼の声には、聞き手を圧倒するような威力が漲っている。",
    "key": "威_イ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.47,
    "ok": true,
    "audio_s": 3.9,
    "bytes": 344108
  },
  {
    "exp": "R",
    "tag": "r040",
    "ref": "r10",
    "text": "庭の雑草を根こそぎ枯らすために、強力な除草剤を撒いた。",
    "key": "枯_からす_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.63,
    "ok": true,
    "audio_s": 4.5,
    "bytes": 397356
  },
  {
    "exp": "R",
    "tag": "r041",
    "ref": "r10",
    "text": "私は山の中で道に迷ってしまった。",
    "key": "迷_まよう_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.08,
    "ok": true,
    "audio_s": 2.88,
    "bytes": 253996
  },
  {
    "exp": "R",
    "tag": "r042",
    "ref": "r10",
    "text": "鞄の中を見てください。",
    "key": "中_なか_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.68,
    "ok": true,
    "audio_s": 1.67,
    "bytes": 147500
  },
  {
    "exp": "R",
    "tag": "r043",
    "ref": "r10",
    "text": "工場からの排水による水質汚染が深刻です。",
    "key": "染_セン_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.13,
    "ok": true,
    "audio_s": 3.39,
    "bytes": 299052
  },
  {
    "exp": "R",
    "tag": "r044",
    "ref": "r10",
    "text": "彼の胸毛は濃くて、非常に目立つ。",
    "key": "胸_むな_1",
    "model": "s2.1-pro",
    "elapsed_s": 0.89,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r045",
    "ref": "r10",
    "text": "激しい議論の末、私たちは最終的に敗北を認めた。",
    "key": "北_ホク_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.48,
    "ok": true,
    "audio_s": 4.37,
    "bytes": 385068
  },
  {
    "exp": "R",
    "tag": "r046",
    "ref": "r10",
    "text": "彼女は世界一周旅行をした。",
    "key": "界_カイ_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.9,
    "ok": true,
    "audio_s": 2.37,
    "bytes": 208940
  },
  {
    "exp": "R",
    "tag": "r047",
    "ref": "r10",
    "text": "私は社長の秘書として、業務の補佐をしている。",
    "key": "佐_サ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.45,
    "ok": true,
    "audio_s": 3.39,
    "bytes": 299052
  },
  {
    "exp": "R",
    "tag": "r048",
    "ref": "r10",
    "text": "生徒たちはグループを成して議論を始めた。",
    "key": "成_なす_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.12,
    "ok": true,
    "audio_s": 3.07,
    "bytes": 270380
  },
  {
    "exp": "R",
    "tag": "r049",
    "ref": "r10",
    "text": "舞台で役者が拍子木を打つ音は緊張感があります。",
    "key": "木_き_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.48,
    "ok": true,
    "audio_s": 3.48,
    "bytes": 307244
  },
  {
    "exp": "R",
    "tag": "r050",
    "ref": "r10",
    "text": "この山は天然の要塞として機能していた。",
    "key": "塞_サイ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.43,
    "ok": true,
    "audio_s": 3.25,
    "bytes": 286764
  },
  {
    "exp": "R",
    "tag": "r051",
    "ref": "r10",
    "text": "犯人は巧妙な手口で個人情報を詐取しようとした。",
    "key": "詐_サ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.59,
    "ok": true,
    "audio_s": 3.81,
    "bytes": 335916
  },
  {
    "exp": "R",
    "tag": "r052",
    "ref": "r10",
    "text": "過去のことは気にしないで、前に進みましょう。",
    "key": "去_コ_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.46,
    "ok": true,
    "audio_s": 2.93,
    "bytes": 258092
  },
  {
    "exp": "R",
    "tag": "r053",
    "ref": "r10",
    "text": "聖徳太子の時代、紫は最も高貴な色とされていた。",
    "key": "紫_むらさき_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.44,
    "ok": true,
    "audio_s": 4.13,
    "bytes": 364588
  },
  {
    "exp": "R",
    "tag": "r054",
    "ref": "r10",
    "text": "彼の猫は真っ黒です。",
    "key": "黒_くろ_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.7,
    "ok": true,
    "audio_s": 1.63,
    "bytes": 143404
  },
  {
    "exp": "R",
    "tag": "r055",
    "ref": "r10",
    "text": "運動会で、生徒たちは堂々と行進した。",
    "key": "行_コウ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.25,
    "ok": true,
    "audio_s": 3.39,
    "bytes": 299052
  },
  {
    "exp": "R",
    "tag": "r056",
    "ref": "r10",
    "text": "彼は心身ともに剛健な人物だ。",
    "key": "剛_ゴウ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.34,
    "ok": true,
    "audio_s": 2.74,
    "bytes": 241708
  },
  {
    "exp": "R",
    "tag": "r057",
    "ref": "r10",
    "text": "毎晩、寝る前にクラシック音楽を聞きます。",
    "key": "聞_きく_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.02,
    "ok": true,
    "audio_s": 3.07,
    "bytes": 270380
  },
  {
    "exp": "R",
    "tag": "r058",
    "ref": "r10",
    "text": "新しい国際線の就航により、アクセスが便利になった。",
    "key": "航_コウ_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.38,
    "ok": true,
    "audio_s": 4.09,
    "bytes": 360492
  },
  {
    "exp": "R",
    "tag": "r059",
    "ref": "r10",
    "text": "古い石碑に刻まれた文字は、歴史を物語っている。",
    "key": "碑_ヒ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.3,
    "ok": true,
    "audio_s": 3.58,
    "bytes": 315436
  },
  {
    "exp": "R",
    "tag": "r060",
    "ref": "r10",
    "text": "彼は今、留守です。",
    "key": "守_ス_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.67,
    "ok": true,
    "audio_s": 1.58,
    "bytes": 139308
  },
  {
    "exp": "R",
    "tag": "r061",
    "ref": "r10",
    "text": "腕時計を腕につける。",
    "key": "腕_うで_2",
    "model": "s2.1-pro",
    "elapsed_s": 0.71,
    "ok": true,
    "audio_s": 1.76,
    "bytes": 155692
  },
  {
    "exp": "R",
    "tag": "r062",
    "ref": "r10",
    "text": "彼女はパーティーのために華やかに装って出かけた。",
    "key": "装_よそおう_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.25,
    "ok": true,
    "audio_s": 3.58,
    "bytes": 315436
  },
  {
    "exp": "R",
    "tag": "r063",
    "ref": "r10",
    "text": "子供たちは海岸で砂遊びをした。",
    "key": "砂_すな_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.23,
    "ok": true,
    "audio_s": 2.51,
    "bytes": 221228
  },
  {
    "exp": "R",
    "tag": "r064",
    "ref": "r10",
    "text": "このスープは味が淡くて、素材の良さが引き立っている。",
    "key": "淡_あわい_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.57,
    "ok": true,
    "audio_s": 3.9,
    "bytes": 344108
  },
  {
    "exp": "R",
    "tag": "r065",
    "ref": "r10",
    "text": "熟練の技を持つ職人がこの家具を作った。",
    "key": "練_レン_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.06,
    "ok": true,
    "audio_s": 3.16,
    "bytes": 278572
  },
  {
    "exp": "R",
    "tag": "r066",
    "ref": "r10",
    "text": "この作業は今日中に済ませておきたい。",
    "key": "済_すむ_1",
    "model": "s2.1-pro",
    "elapsed_s": 0.94,
    "ok": true,
    "audio_s": 2.46,
    "bytes": 217132
  },
  {
    "exp": "R",
    "tag": "r067",
    "ref": "r10",
    "text": "資金不足により、その大規模プロジェクトは頓挫した。",
    "key": "挫_ザ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.26,
    "ok": true,
    "audio_s": 3.48,
    "bytes": 307244
  },
  {
    "exp": "R",
    "tag": "r068",
    "ref": "r10",
    "text": "その映画は、観客に真の恐怖を与えた。",
    "key": "恐_キョウ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.36,
    "ok": true,
    "audio_s": 3.25,
    "bytes": 286764
  },
  {
    "exp": "R",
    "tag": "r069",
    "ref": "r10",
    "text": "彼は表の顔と裏の顔を持っている。",
    "key": "表_おもて_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.33,
    "ok": true,
    "audio_s": 2.93,
    "bytes": 258092
  },
  {
    "exp": "R",
    "tag": "r070",
    "ref": "r10",
    "text": "この問題は、専門家による徹底的な調査によって理解が深まっていくだろう。",
    "key": "深_ふかまる_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.59,
    "ok": true,
    "audio_s": 5.02,
    "bytes": 442412
  },
  {
    "exp": "R",
    "tag": "r071",
    "ref": "r10",
    "text": "彼は嘘をごまかすために、事実をうまく紛らわした。",
    "key": "紛_まぎらわす_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.47,
    "ok": true,
    "audio_s": 3.72,
    "bytes": 327724
  },
  {
    "exp": "R",
    "tag": "r072",
    "ref": "r10",
    "text": "彼は会議に度々遅刻した。",
    "key": "度_たび_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.86,
    "ok": true,
    "audio_s": 2.23,
    "bytes": 196652
  },
  {
    "exp": "R",
    "tag": "r073",
    "ref": "r10",
    "text": "犯人は覆面をかぶっていたため、特定が難しかった。",
    "key": "覆_フク_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.22,
    "ok": true,
    "audio_s": 3.76,
    "bytes": 331820
  },
  {
    "exp": "R",
    "tag": "r074",
    "ref": "r10",
    "text": "彼らには多くの共通点があります。",
    "key": "共_キョウ_1",
    "model": "s2.1-pro",
    "elapsed_s": 0.87,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r075",
    "ref": "r10",
    "text": "彼の発言を踏まえ、次の会議ではこの件について詳しく議論すべきだ。",
    "key": "踏_ふまえる_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.69,
    "ok": true,
    "audio_s": 5.02,
    "bytes": 442412
  },
  {
    "exp": "R",
    "tag": "r076",
    "ref": "r10",
    "text": "戦争の醜さが、平和の尊さを改めて教えてくれる。",
    "key": "醜_みにくい_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.69,
    "ok": true,
    "audio_s": 4.23,
    "bytes": 372780
  },
  {
    "exp": "R",
    "tag": "r077",
    "ref": "r10",
    "text": "彼は人々に聖人と呼ばれていた。",
    "key": "聖_セイ_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.34,
    "ok": true,
    "audio_s": 2.55,
    "bytes": 225324
  },
  {
    "exp": "R",
    "tag": "r078",
    "ref": "r10",
    "text": "このシャツは国内で丁寧に縫製されています。",
    "key": "縫_ホウ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.47,
    "ok": true,
    "audio_s": 3.11,
    "bytes": 274476
  },
  {
    "exp": "R",
    "tag": "r079",
    "ref": "r10",
    "text": "私は新しい本を読み始めた。",
    "key": "本_ホン_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.0,
    "ok": true,
    "audio_s": 2.41,
    "bytes": 213036
  },
  {
    "exp": "R",
    "tag": "r080",
    "ref": "r10",
    "text": "天然痘は、人類が根絶に成功した唯一の感染症だと言われている。",
    "key": "痘_トウ_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.79,
    "ok": true,
    "audio_s": 5.34,
    "bytes": 471084
  },
  {
    "exp": "R",
    "tag": "r081",
    "ref": "r10",
    "text": "この鉱石から高品質の鉄鋼を精錬するのには、高度な技術が必要だ。",
    "key": "錬_レン_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.98,
    "ok": true,
    "audio_s": 5.15,
    "bytes": 454700
  },
  {
    "exp": "R",
    "tag": "r082",
    "ref": "r10",
    "text": "熟していない柿を食べたら、とても渋かった。",
    "key": "渋_しぶい_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.14,
    "ok": true,
    "audio_s": 3.25,
    "bytes": 286764
  },
  {
    "exp": "R",
    "tag": "r083",
    "ref": "r10",
    "text": "今日の業務を日誌に記録してください。",
    "key": "誌_シ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.04,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r084",
    "ref": "r10",
    "text": "宴会で部長が急に腹芸を始めた。",
    "key": "腹_はら_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.13,
    "ok": true,
    "audio_s": 2.83,
    "bytes": 249900
  },
  {
    "exp": "R",
    "tag": "r085",
    "ref": "r10",
    "text": "議論の末、私たちは協定を結ぶことにした。",
    "key": "末_すえ_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.3,
    "ok": true,
    "audio_s": 3.62,
    "bytes": 319532
  },
  {
    "exp": "R",
    "tag": "r086",
    "ref": "r10",
    "text": "有名な画廊で新しい作品展が始まった。",
    "key": "廊_ロウ_2",
    "model": "s2.1-pro",
    "elapsed_s": 1.14,
    "ok": true,
    "audio_s": 3.2,
    "bytes": 282668
  },
  {
    "exp": "R",
    "tag": "r087",
    "ref": "r10",
    "text": "天地の道という表現は古典に見られる。",
    "key": "天_あめ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.04,
    "ok": true,
    "audio_s": 2.69,
    "bytes": 237612
  },
  {
    "exp": "R",
    "tag": "r088",
    "ref": "r10",
    "text": "捜査の範囲を徐々に絞る。",
    "key": "絞_しぼる_1",
    "model": "s2.1-pro",
    "elapsed_s": 0.8,
    "ok": true,
    "audio_s": 1.9,
    "bytes": 167980
  },
  {
    "exp": "R",
    "tag": "r089",
    "ref": "r10",
    "text": "彼は喜びを全身で表す。",
    "key": "表_あらわす_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.93,
    "ok": true,
    "audio_s": 2.32,
    "bytes": 204844
  },
  {
    "exp": "R",
    "tag": "r090",
    "ref": "r10",
    "text": "会議の日程が急遽、明日に早まった。",
    "key": "早_はやまる_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.08,
    "ok": true,
    "audio_s": 2.97,
    "bytes": 262188
  },
  {
    "exp": "R",
    "tag": "r091",
    "ref": "r10",
    "text": "朝礼で社長が訓示を述べた。",
    "key": "朝_チョウ_0",
    "model": "s2.1-pro",
    "elapsed_s": 0.84,
    "ok": true,
    "audio_s": 2.23,
    "bytes": 196652
  },
  {
    "exp": "R",
    "tag": "r092",
    "ref": "r10",
    "text": "取り返しのつかない過ちを犯すところだった。",
    "key": "犯_おかす_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.05,
    "ok": true,
    "audio_s": 2.83,
    "bytes": 249900
  },
  {
    "exp": "R",
    "tag": "r093",
    "ref": "r10",
    "text": "この冬、チェック柄が再び流行している。",
    "key": "流_リュウ_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.36,
    "ok": true,
    "audio_s": 3.2,
    "bytes": 282668
  },
  {
    "exp": "R",
    "tag": "r094",
    "ref": "r10",
    "text": "今年は米が豊作だったので、農家は喜んでいる。",
    "key": "作_サク_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.35,
    "ok": true,
    "audio_s": 3.72,
    "bytes": 327724
  },
  {
    "exp": "R",
    "tag": "r095",
    "ref": "r10",
    "text": "新入社員は三ヶ月間の研修を受けた。",
    "key": "研_ケン_0",
    "model": "s2.1-pro",
    "elapsed_s": 1.14,
    "ok": true,
    "audio_s": 3.11,
    "bytes": 274476
  },
  {
    "exp": "R",
    "tag": "r096",
    "ref": "r10",
    "text": "冬はやはり、寄せ鍋が美味しいですね。",
    "key": "鍋_なべ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.0,
    "ok": true,
    "audio_s": 2.6,
    "bytes": 229420
  },
  {
    "exp": "R",
    "tag": "r097",
    "ref": "r10",
    "text": "科学者たちは新たな難病に挑んでいる。",
    "key": "挑_いどむ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.23,
    "ok": true,
    "audio_s": 2.88,
    "bytes": 253996
  },
  {
    "exp": "R",
    "tag": "r098",
    "ref": "r10",
    "text": "予算を大幅に超過してしまったため、計画を見直す必要がある。",
    "key": "超_チョウ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.88,
    "ok": true,
    "audio_s": 4.55,
    "bytes": 401452
  },
  {
    "exp": "R",
    "tag": "r099",
    "ref": "r10",
    "text": "会場は歌手の登場に熱狂した。",
    "key": "狂_キョウ_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.0,
    "ok": true,
    "audio_s": 2.46,
    "bytes": 217132
  },
  {
    "exp": "R",
    "tag": "r100",
    "ref": "r10",
    "text": "彼は何か悩みがあるのか、表情が暗い。",
    "key": "暗_くらい_1",
    "model": "s2.1-pro",
    "elapsed_s": 1.26,
    "ok": true,
    "audio_s": 3.11,
    "bytes": 274476
  },
  {
    "exp": "N",
    "tag": "n01",
    "ref": "r10",
    "text": "会議は14時30分に始まります。",
    "key": "n01_時刻",
    "model": "s2.1-pro",
    "elapsed_s": 1.34,
    "ok": true,
    "audio_s": 2.69,
    "bytes": 237612
  },
  {
    "exp": "N",
    "tag": "n02",
    "ref": "r10",
    "text": "参加費は4,980円です。",
    "key": "n02_金額",
    "model": "s2.1-pro",
    "elapsed_s": 1.17,
    "ok": true,
    "audio_s": 2.83,
    "bytes": 249900
  },
  {
    "exp": "N",
    "tag": "n03",
    "ref": "r10",
    "text": "満足度は96.5%でした。",
    "key": "n03_割合",
    "model": "s2.1-pro",
    "elapsed_s": 1.09,
    "ok": true,
    "audio_s": 3.02,
    "bytes": 266284
  },
  {
    "exp": "N",
